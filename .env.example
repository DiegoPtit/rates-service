# ═══════════════════════════════════════════════════════════════════════════
# EJEMPLO DE ARCHIVO .env PARA MICROSERVICIOS
# ═══════════════════════════════════════════════════════════════════════════
# 
# NOTA: Este archivo es solo un ejemplo. Las variables de entorno se configuran
# directamente en ecosystem.config.js para PM2.
#
# Si ejecutas los microservicios manualmente (sin PM2), copia este archivo
# a cada directorio de microservicio y renómbralo a .env
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN PARA BCV MICROSERVICE
# ═══════════════════════════════════════════════════════════════════════════

# Puerto del servidor
PORT=3001

# URL base de la aplicación principal
APP_BASE_URL=https://havainventory.infinityfreeapp.com/inventario-app/web

# Endpoint para actualizar la tasa BCV
UPDATE_RATE_ENDPOINT=/index.php?r=site/update-bcv

# URL del Banco Central de Venezuela
BCV_URL=http://www.bcv.org.ve

# Timeout para las peticiones (en milisegundos)
PAGE_TIMEOUT=30000

# Número de reintentos en caso de error
RETRY_ATTEMPTS=3

# Intervalo de actualización automática (en minutos)
UPDATE_INTERVAL=15

# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN PARA BINANCE MICROSERVICE
# ═══════════════════════════════════════════════════════════════════════════

# Puerto del servidor
# PORT=3000

# URL base de la aplicación principal
# APP_BASE_URL=https://havainventory.infinityfreeapp.com/inventario-app/web

# Endpoint para actualizar la tasa USDT
# UPDATE_RATE_ENDPOINT=/index.php?r=site/update-usdt-rate

# URL de Binance P2P
# P2P_URL=https://p2p.binance.com/trade/all-payments/USDT?fiat=VES

# Timeout para las peticiones (en milisegundos)
# PAGE_TIMEOUT=30000

# Número de reintentos en caso de error
# RETRY_ATTEMPTS=3

# Intervalo de actualización automática (en minutos)
# UPDATE_INTERVAL=5

# ═══════════════════════════════════════════════════════════════════════════
# NOTAS IMPORTANTES
# ═══════════════════════════════════════════════════════════════════════════
#
# 1. Si usas PM2 (recomendado), NO necesitas archivos .env
#    Las variables se configuran en ecosystem.config.js
#
# 2. Si ejecutas manualmente (node server.js), copia este archivo a:
#    - bcv-microservice/.env
#    - binance-microservice/.env
#    Y descomenta las variables correspondientes
#
# 3. Los valores por defecto están en config.js de cada microservicio
#
# 4. NUNCA subas archivos .env a Git (ya están en .gitignore)
#
# ═══════════════════════════════════════════════════════════════════════════
